# Video Studio — local, single-user, zero-cost generation.
# Node 22+ loads this file automatically via --env-file=.env. Copy to .env to customise.

FAIR_PORT=4310
FAIR_OLLAMA_URL=http://127.0.0.1:11434

# --- Local planning models (Ollama) ----------------------------------------
# Planner: fast structured-output model. Recommended bake-off pick:
FAIR_MODEL=gpt-oss:20b
# Critic: a DIFFERENT model reviews the plan so the checker is not the writer.
FAIR_REVIEW_MODEL=qwen3:30b-a3b-instruct-2507
# Budget dev models also work: gemma3:12b, qwen2.5:7b
# FAIR_MODEL_TIMEOUT_MS=180000

# --- Narration --------------------------------------------------------------
# Canonical teacher voice: local Qwen3-TTS VoiceDesign (MLX, Apache-2.0).
# Requires the pip-installed qwen venv and downloaded 8-bit model (see
# scripts/fair-setup-voice.mjs --check and docs/fair-voices.md).
FAIR_TTS_PROVIDER=qwentts
# FAIR_QWEN_PYTHON=.fair-neural/qwen-venv/bin/python
# FAIR_QWEN_MODEL_DIR=.fair-neural/qwen-voice-design-8bit
# FAIR_QWEN_SEED=42
# Voice persona direction text lives in content/voices/teacher.json.
# Draft fallbacks: piper (Indian English, fastest) | kokoro | say (dev only).
FAIR_KOKORO_VOICE=bf_emma
FAIR_KOKORO_SPEED=0.95
# FAIR_KOKORO_URL=http://127.0.0.1:8880/v1/audio/speech
# FAIR_KOKORO_PYTHON / FAIR_KOKORO_MODEL / FAIR_KOKORO_VOICES — absolute paths
# FAIR_PIPER_PYTHON / FAIR_PIPER_MODEL / FAIR_PIPER_CONFIG — absolute paths
# FAIR_PIPER_VOICE=en_IN-spicor
# FAIR_PIPER_LENGTH_SCALE=1.08
# FAIR_SAY_VOICE=Samantha

# --- Storage ---------------------------------------------------------------
# FAIR_DATA_DIR=/absolute/path/to/video-studio-data   (default ./.fair-video)
# FAIR_CURRICULUM_DIR=/absolute/path/to/curriculum     (default ./curriculum)
# FAIR_FFMPEG=/path/to/ffmpeg
# FAIR_FFPROBE=/path/to/ffprobe

# --- Optional: open-source render version (Manim + Wan2.2 footage) ---------
# ollama pull qwen2.5:7b  (or set FAIR_OPEN_MODEL to another installed model)
# FAIR_OPEN_MODEL=qwen2.5:7b
# FAIR_MANIM_PYTHON=/absolute/path/to/.fair-open/venv/bin/python
# FAIR_COMFYUI_URL=http://127.0.0.1:8188
# Apple Silicon: FP16 weights + CPU text encoder; euler sampler is enforced
# (uni_pc corrupts Wan2.2 output on MPS — ComfyUI issue #15921).
# FAIR_WAN_TEXT_ENCODER=umt5_xxl_fp16.safetensors
# FAIR_WAN_TEXT_DEVICE=cpu

# --- Paid providers (disabled by design for the free pipeline) -------------
# These remain available for experiments but are never required and never
# silently used. The default pipeline performs no paid API calls.
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
