{
  "name": "video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone concept-to-video teaching studio: curriculum-tree batch generation, local planning, narration and isolated rendering. Zero paid APIs.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build:ui": "vite build --config frontend/vite.config.ts",
    "check:ui": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "dev:ui": "vite --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:pipeline": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "test:wan": "node --env-file-if-exists=.env scripts/smoke-wan.mjs",
    "test:video-models": "node --env-file-if-exists=.env scripts/smoke-video-models.mjs",
    "generate": "node --env-file-if-exists=.env src/cli.mjs",
    "topic": "node --env-file-if-exists=.env src/cli.mjs --topic",
    "batch": "node --env-file-if-exists=.env src/batch.mjs",
    "coverage": "node --env-file-if-exists=.env src/batch.mjs --coverage",
    "check": "fail=0; for f in src/*.mjs studio-v2/*.mjs studio-v2/render/*.mjs studio-v2/worker/*.mjs public/*.mjs scripts/*.mjs tools/*.mjs test/*.mjs; do node --check \"$f\" || fail=1; done; exit $fail",
    "render:discovery": "node --env-file-if-exists=.env scripts/render-discovery.mjs",
    "check:open": "node --env-file-if-exists=.env scripts/check-open.mjs",
    "check:proof": "node --env-file-if-exists=.env src/proof-quality.mjs proofs/place-value-machine/out.mp4 60",
    "check:env": "node --env-file-if-exists=.env tools/check-env.mjs",
    "setup:comfy": "node scripts/setup-comfy.mjs",
    "start:comfy": "node scripts/start-comfy.mjs",
    "metrics": "node tools/teaching-metrics.mjs",
    "recompose": "node --env-file-if-exists=.env scripts/recompose.mjs",
    "render:phase-a": "node --env-file-if-exists=.env scripts/fraction-phase-a.mjs",
    "setup:studio-v2": "node scripts/setup-studio-v2.mjs",
    "test:studio-v2": "node --test test/v2-*.test.mjs",
    "render:cinematic-benchmark": "node --env-file-if-exists=.env scripts/fair-render-cinematic-benchmark.mjs",
    "check:cinematic-benchmark": "node --env-file-if-exists=.env src/fair-cinematic-quality.mjs proofs/cinematic-benchmark/qa-spec.json proofs/cinematic-benchmark/candidate.mp4 proofs/cinematic-benchmark/automated-quality-report.json"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.8.161",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
